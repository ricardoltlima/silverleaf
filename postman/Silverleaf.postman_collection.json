    {
      "name": "Auth - Register",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const existingEmail = pm.collectionVariables.get('email');",
              "if (!existingEmail || existingEmail.includes('replace-me')) {",
              "    const unique = Date.now();",
              "    pm.collectionVariables.set('email', `resident.${unique}@example.com`);",
              "}",
              "if (!pm.collectionVariables.get('fullName')) {",
              "    pm.collectionVariables.set('fullName', 'Test Resident');",
              "}",
              "if (!pm.collectionVariables.get('password')) {",
              "    pm.collectionVariables.set('password', 'Passw0rd!');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Register returns 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Register returns tokens', function () {",
              "    pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
              "    pm.expect(json.refreshToken).to.be.a('string').and.not.empty;",
              "});",
              "pm.collectionVariables.set('accessToken', json.accessToken);",
              "pm.collectionVariables.set('refreshToken', json.refreshToken);",
              "pm.collectionVariables.set('accessTokenExpiresAt', json.accessTokenExpiresAt);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"{{fullName}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        }
      }
    },
